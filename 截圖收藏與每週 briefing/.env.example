# 複製成 .env 後填入。.env 已列入 .gitignore，不會被提交。

# 必填：向 Telegram 的 @BotFather 申請的機器人 token
TELEGRAM_BOT_TOKEN=

# 必填：允許使用的 Telegram 使用者數字 ID（多個用逗號分隔）
# 不知道自己的 ID？先隨便填一個數字啟動，私訊機器人後它會告訴你你的 ID。
ALLOWED_USER_IDS=

# AI 供應商：anthropic（Claude 圖片理解）或 none（只收藏、不整理，不產生 AI 費用）
AI_PROVIDER=anthropic
# AI_PROVIDER=anthropic 時必填：https://console.anthropic.com/ 申請
ANTHROPIC_API_KEY=
# 可改成較便宜的模型，例如 claude-sonnet-5-5 或 claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# 模型拒答時由伺服器自動改用其他模型重跑（default）；不需要可設 off
AI_FALLBACKS=default

# 資料目錄（SQLite 與原圖）。Docker 內固定用 /data，對應到專案的 ./data
DATA_DIR=./data

# 分類清單（逗號分隔）。改了之後重新啟動即可；「其他」一定會保留
CATEGORIES=工作／學習,科技,理財,健康,旅遊,美食,購物,娛樂,其他

# 每週 briefing 時間
TIMEZONE=Asia/Taipei
BRIEFING_WEEKDAY=sun
BRIEFING_TIME=20:00
# 週日 20:00 時剛好停機的話，重啟後幾小時內仍會補寄
BRIEFING_GRACE_HOURS=48

# 其他（通常不用改）
MAX_IMAGE_MB=20
AI_RETRY_BASE_MINUTES=10
AI_MAX_ATTEMPTS=6
